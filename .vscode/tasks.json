{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Aircraft Black Box",
            "type": "shell",
            "command": "clang++",
            "args": [
                "-std=c++20",
                "-g",
                "main.cpp",
                "FlightSimulator.cpp",
                "FlightComputer.cpp",
                "-o",
                "blackbox"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        }
    ]
}